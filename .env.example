# Application Environment Configuration
ENV=development
PROJECT_NAME="Production URL Shortener"
BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shortener
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shortener_test

# Redis Configuration (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_ALWAYS_EAGER=false

# Security & Authentication
JWT_SECRET=insecure-dev-secret-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
IP_HASH_SALT=dev-salt-change-in-production-abcdef123456

# Network & Validation Flags
TRUSTED_PROXY=false
REJECT_PRIVATE_IPS=true
CACHE_ENABLED=true

# GeoIP Database Path (Optional)
GEOIP_DB_PATH=

# Rate Limits
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LINK_CREATE_PER_HOUR=20
RATE_LIMIT_REDIRECT_PER_MIN=300

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
